# Server-only inquiry delivery and persistence
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
CONTACT_EMAIL=sales@realismthrift.com
CONTACT_FROM_EMAIL=website@realismthrift.com
AUTO_REPLY_FROM_EMAIL=sales@realismthrift.com
SUPABASE_URL=
SUPABASE_SECRET_KEY=
INQUIRY_RETRY_SECRET=

# Outreach: separate Neon database; do not point previews at production.
OUTREACH_DATABASE_URL=
OUTREACH_DATABASE_URL_UNPOOLED=
OUTREACH_SITE_ORIGIN=https://www.realismthrift.com
OUTREACH_RATE_LIMIT_SECRET=
# Disabled until OAuth and received-message verification are complete.
OUTREACH_SENDING_ENABLED=false
OUTREACH_RFC8058_VERIFIED=false
OUTREACH_TEST_RECIPIENTS=
# Use google only after its received DKIM signature covers both list headers.
OUTREACH_DKIM_MODE=
OUTREACH_DKIM_SELECTOR=outreach
OUTREACH_DKIM_PRIVATE_KEY=
# Private MCP and operator authentication (Supabase OAuth 2.1 + Google login).
SUPABASE_PUBLISHABLE_KEY=
OUTREACH_OPERATOR_USER_ID=
OUTREACH_OAUTH_CLIENT_ID=
# A separate internal Google OAuth application, not the existing Gmail plugin token.
OUTREACH_GOOGLE_CLIENT_ID=
OUTREACH_GOOGLE_CLIENT_SECRET=
# 32 random bytes in base64; encrypts credentials stored in outreach_events.
OUTREACH_CREDENTIAL_KEY=
# Optional manual setup alternative to /outreach/connect.
OUTREACH_GOOGLE_REFRESH_TOKEN=

# Sanity configuration data
NEXT_PUBLIC_SANITY_PROJECT_ID=unxd1ije
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-06
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
SANITY_API_EDITOR_TOKEN=
SANITY_API_READ_TOKEN=


# APP_URL: The URL where this site is hosted.
# Used for self-referential links and API endpoints.
APP_URL="https://www.realismthrift.com"

# Tracking & Analytics
NEXT_PUBLIC_ANALYTICS_ENABLED=true
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=

# SSG revalidation (server-only; generate a unique secret per environment)
SANITY_REVALIDATE_SECRET=
NEXT_PUBLIC_SANITY_VISUAL_EDITING=false
